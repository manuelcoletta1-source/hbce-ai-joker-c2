{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuelcoletta1-source.github.io/hermeticum-bce-platform/schemas/hbce-capability.schema.json",
  "title": "HBCE Platform Core Capability Schema v1",
  "description": "Canonical HBCE Platform Core schema representing a technical or logical capability associated with an operational entity. A capability describes what operation classes an entity can technically or logically perform. Capability does not establish mandate, authority, authorization, execution, execution success, legal certification or public authority status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proto",
    "kind",
    "version",
    "capability_id",
    "capability_version",
    "holder_ref",
    "capability_class",
    "operation_classes",
    "scope",
    "source",
    "state",
    "valid_from",
    "valid_until",
    "created_at",
    "updated_at",
    "evidence_state",
    "evidence_reference",
    "payload_sha256",
    "append_only",
    "genealogy",
    "boundary"
  ],
  "properties": {
    "proto": {
      "type": "string",
      "const": "HBCE-CAPABILITY-v1"
    },
    "kind": {
      "type": "string",
      "enum": [
        "HBCE_CORE_CAPABILITY"
      ]
    },
    "version": {
      "type": "string",
      "const": "v1"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^CAP-[0-9A-Z:\\-_.]+$",
      "minLength": 5,
      "maxLength": 128,
      "description": "Canonical capability identifier."
    },
    "capability_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Version of the capability object. This is distinct from the schema version."
    },
    "holder_ref": {
      "type": "string",
      "pattern": "^[A-Z0-9_\\-:.]+$",
      "minLength": 3,
      "maxLength": 160,
      "description": "Reference to the actor, component, agent, system, node, device or other entity associated with the capability. The reference must not contain raw personal identifiers."
    },
    "capability_class": {
      "type": "string",
      "pattern": "^[A-Z0-9_\\-:.]+$",
      "minLength": 3,
      "maxLength": 128,
      "description": "Controlled capability-class identifier."
    },
    "operation_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_\\-:.]+$",
        "minLength": 3,
        "maxLength": 128
      },
      "description": "Operation classes that this capability represents. Presence in this list does not grant authority or authorize execution."
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_class_refs",
        "iospace_refs",
        "constraint_refs"
      ],
      "properties": {
        "target_class_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_\\-:.]+$",
            "minLength": 3,
            "maxLength": 160
          },
          "description": "Optional target-class boundaries associated with the capability."
        },
        "iospace_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_\\-:.]+$",
            "minLength": 3,
            "maxLength": 160
          },
          "description": "Optional operational-space references in which the capability may technically or logically exist. This does not grant authority inside those spaces."
        },
        "constraint_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_\\-:.]+$",
            "minLength": 3,
            "maxLength": 160
          },
          "description": "Controlled references to capability-specific technical or logical constraints."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "source_ref"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "TECHNICAL_IMPLEMENTATION",
            "DECLARED_INTERFACE",
            "ROLE_ASSIGNMENT",
            "POLICY_ASSIGNMENT",
            "ATTESTATION_REFERENCE",
            "OTHER_CONTROLLED_REFERENCE"
          ],
          "description": "Class of source supporting the capability representation."
        },
        "source_ref": {
          "type": "string",
          "pattern": "^[A-Z0-9_\\-:.]+$",
          "minLength": 3,
          "maxLength": 160,
          "description": "Controlled minimized reference to the source supporting the capability representation."
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PENDING",
        "ACTIVE",
        "LIMITED",
        "SUSPENDED",
        "CONTESTED",
        "COMPROMISED",
        "EXPIRED",
        "REVOKED",
        "SUPERSEDED",
        "UNKNOWN"
      ],
      "description": "Capability lifecycle state. AUTHORIZED and DENIED are intentionally excluded because capability state is not authorization state."
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_state": {
      "type": "string",
      "enum": [
        "PRESENT",
        "MISSING",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ],
      "description": "State of the evidence supporting the capability representation. MISSING or UNKNOWN must not be silently treated as PRESENT."
    },
    "evidence_reference": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9_:\\-.]+$",
      "minLength": 3,
      "maxLength": 160,
      "description": "Controlled reference to evidence supporting the capability representation. Raw evidence must remain outside this object."
    },
    "implementation_reference": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9_:\\-.]+$",
      "minLength": 3,
      "maxLength": 160,
      "description": "Optional controlled reference to the technical implementation associated with the capability."
    },
    "revocation_reference": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9_:\\-.]+$",
      "minLength": 3,
      "maxLength": 160
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CAP-[0-9A-Z:\\-_.]+$",
      "minLength": 5,
      "maxLength": 128
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 commitment for the controlled canonical capability payload according to the applicable hashing profile."
    },
    "append_only": {
      "type": "boolean",
      "const": true
    },
    "genealogy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_from",
        "previous_state",
        "new_state",
        "cause",
        "evidence_reference",
        "timestamp",
        "hash"
      ],
      "properties": {
        "derived_from": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^CAP-[0-9A-Z:\\-_.]+$",
          "minLength": 5,
          "maxLength": 128
        },
        "previous_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "DRAFT",
            "PENDING",
            "ACTIVE",
            "LIMITED",
            "SUSPENDED",
            "CONTESTED",
            "COMPROMISED",
            "EXPIRED",
            "REVOKED",
            "SUPERSEDED",
            "UNKNOWN"
          ]
        },
        "new_state": {
          "type": "string",
          "enum": [
            "DRAFT",
            "PENDING",
            "ACTIVE",
            "LIMITED",
            "SUSPENDED",
            "CONTESTED",
            "COMPROMISED",
            "EXPIRED",
            "REVOKED",
            "SUPERSEDED",
            "UNKNOWN"
          ]
        },
        "cause": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240,
          "description": "Controlled safe cause text or reference. Must not contain raw sensitive evidence."
        },
        "evidence_reference": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9_:\\-.]+$",
          "minLength": 3,
          "maxLength": 160
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_minimization",
        "reference_over_raw_evidence",
        "capability_not_mandate",
        "capability_not_authority",
        "capability_not_authorization",
        "capability_not_execution",
        "active_capability_not_authority",
        "append_only_genealogy",
        "no_automatic_execution_claim",
        "no_regulated_certification_claim",
        "no_public_authority_claim",
        "fail_closed"
      ],
      "properties": {
        "data_minimization": {
          "type": "boolean",
          "const": true
        },
        "reference_over_raw_evidence": {
          "type": "boolean",
          "const": true
        },
        "capability_not_mandate": {
          "type": "boolean",
          "const": true
        },
        "capability_not_authority": {
          "type": "boolean",
          "const": true
        },
        "capability_not_authorization": {
          "type": "boolean",
          "const": true
        },
        "capability_not_execution": {
          "type": "boolean",
          "const": true
        },
        "active_capability_not_authority": {
          "type": "boolean",
          "const": true
        },
        "append_only_genealogy": {
          "type": "boolean",
          "const": true
        },
        "no_automatic_execution_claim": {
          "type": "boolean",
          "const": true
        },
        "no_regulated_certification_claim": {
          "type": "boolean",
          "const": true
        },
        "no_public_authority_claim": {
          "type": "boolean",
          "const": true
        },
        "fail_closed": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 600,
      "description": "Controlled safe note only. Must not contain raw sensitive evidence, secrets, credentials, identity documents, raw prompts, raw outputs or client files."
    }
  }
}
