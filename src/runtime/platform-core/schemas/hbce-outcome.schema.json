{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuelcoletta1-source.github.io/hermeticum-bce-platform/schemas/hbce-outcome.schema.json",
  "title": "HBCE Platform Core Outcome Schema v1",
  "description": "Canonical HBCE Platform Core schema representing the direct observed result of an exact execution. OUTCOME is distinct from EXECUTION, SUCCESS and CONSEQUENCE. An outcome may record an observed direct result, an explicitly unavailable result, a contested observation or an unknown state. Wider effects belong to CONSEQUENCE.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proto",
    "kind",
    "version",
    "outcome_id",
    "outcome_version",
    "execution_ref",
    "execution_version",
    "execution_sha256",
    "execution_terminal_state_observed",
    "state",
    "evaluated_at",
    "observed_at",
    "observation_source",
    "direct_result",
    "evidence_state",
    "evidence_reference",
    "evt_reference",
    "opc_reference",
    "consequence_reference",
    "payload_sha256",
    "append_only",
    "genealogy",
    "boundary"
  ],
  "properties": {
    "proto": {
      "type": "string",
      "const": "HBCE-OUTCOME-v1"
    },
    "kind": {
      "type": "string",
      "enum": [
        "HBCE_CORE_OUTCOME"
      ]
    },
    "version": {
      "type": "string",
      "const": "v1"
    },
    "outcome_id": {
      "type": "string",
      "pattern": "^OUT-[0-9A-Z:\\-_.]+$",
      "minLength": 5,
      "maxLength": 128
    },
    "outcome_version": {
      "type": "integer",
      "minimum": 1
    },
    "execution_ref": {
      "type": "string",
      "pattern": "^EXE-[0-9A-Z:\\-_.]+$",
      "minLength": 5,
      "maxLength": 128,
      "description": "Exact execution from which this direct result is derived."
    },
    "execution_version": {
      "type": "integer",
      "minimum": 1
    },
    "execution_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Hash commitment to the exact execution payload evaluated."
    },
    "execution_terminal_state_observed": {
      "type": "string",
      "enum": [
        "EXECUTED",
        "FAILED",
        "ABORTED"
      ],
      "description": "Terminal execution state observed when this outcome was evaluated. BLOCKED and non-terminal execution states do not constitute a completed execution outcome."
    },
    "state": {
      "type": "string",
      "enum": [
        "PENDING",
        "OBSERVED",
        "NOT_AVAILABLE",
        "CONTESTED",
        "UNKNOWN"
      ],
      "description": "State of the direct-result observation. OBSERVED does not imply success. CONTESTED means a direct result was observed but its interpretation or validity is contested."
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Time at which outcome evaluation was performed."
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Time at which the direct result was observed. Null when no direct result has been established."
    },
    "observation_source": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "source_type",
        "observer_refs"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "HUMAN",
            "MACHINE",
            "HUMAN_AND_MACHINE",
            "EXTERNAL_SYSTEM"
          ]
        },
        "observer_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_\\-:.]+$",
            "minLength": 3,
            "maxLength": 160
          }
        }
      }
    },
    "direct_result": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "outcome_class",
        "target_ref",
        "result_reference",
        "result_sha256"
      ],
      "properties": {
        "outcome_class": {
          "type": "string",
          "pattern": "^[A-Z0-9_\\-:.]+$",
          "minLength": 3,
          "maxLength": 128,
          "description": "Controlled domain-neutral class for the direct result, for example REQUEST_ACCEPTED, TRANSACTION_FAILED or TASK_INTERRUPTED. The class does not itself encode wider consequence."
        },
        "target_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9_\\-:.]+$",
          "minLength": 3,
          "maxLength": 160
        },
        "result_reference": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9_:\\-.]+$",
          "minLength": 3,
          "maxLength": 160,
          "description": "Controlled minimized reference to the direct result artifact or record when one exists."
        },
        "result_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash commitment to the canonical representation of the observed direct result."
        }
      }
    },
    "evidence_state": {
      "type": "string",
      "enum": [
        "PRESENT",
        "MISSING",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "evidence_reference": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9_:\\-.]+$",
      "minLength": 3,
      "maxLength": 160
    },
    "evt_reference": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9_:\\-.]+$",
      "minLength": 3,
      "maxLength": 160
    },
    "opc_reference": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9_:\\-.]+$",
      "minLength": 3,
      "maxLength": 160
    },
    "consequence_reference": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9_:\\-.]+$",
      "minLength": 3,
      "maxLength": 160,
      "description": "Optional reference to a separately evaluated consequence. Presence does not make OUTCOME equivalent to CONSEQUENCE."
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "append_only": {
      "type": "boolean",
      "const": true
    },
    "genealogy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_from",
        "previous_state",
        "new_state",
        "cause",
        "evidence_reference",
        "timestamp",
        "hash"
      ],
      "properties": {
        "derived_from": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^OUT-[0-9A-Z:\\-_.]+$",
          "minLength": 5,
          "maxLength": 128
        },
        "previous_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "PENDING",
            "OBSERVED",
            "NOT_AVAILABLE",
            "CONTESTED",
            "UNKNOWN"
          ]
        },
        "new_state": {
          "type": "string",
          "enum": [
            "PENDING",
            "OBSERVED",
            "NOT_AVAILABLE",
            "CONTESTED",
            "UNKNOWN"
          ]
        },
        "cause": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "evidence_reference": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9_:\\-.]+$",
          "minLength": 3,
          "maxLength": 160
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_minimization",
        "reference_over_raw_evidence",
        "outcome_requires_execution",
        "outcome_not_execution",
        "outcome_not_success",
        "outcome_not_consequence",
        "execution_terminal_state_required",
        "exact_execution_version_required",
        "execution_hash_binding_required",
        "observed_outcome_requires_direct_result",
        "observed_outcome_requires_evidence",
        "not_available_not_observed",
        "unknown_not_observed",
        "observation_not_inference",
        "direct_result_digest_required",
        "cross_object_binding_runtime_validation_required",
        "temporal_order_runtime_validation_required",
        "append_only_genealogy",
        "no_automatic_success_claim",
        "no_automatic_consequence_claim",
        "no_regulated_certification_claim",
        "no_public_authority_claim",
        "fail_closed"
      ],
      "properties": {
        "data_minimization": {
          "type": "boolean",
          "const": true
        },
        "reference_over_raw_evidence": {
          "type": "boolean",
          "const": true
        },
        "outcome_requires_execution": {
          "type": "boolean",
          "const": true
        },
        "outcome_not_execution": {
          "type": "boolean",
          "const": true
        },
        "outcome_not_success": {
          "type": "boolean",
          "const": true
        },
        "outcome_not_consequence": {
          "type": "boolean",
          "const": true
        },
        "execution_terminal_state_required": {
          "type": "boolean",
          "const": true
        },
        "exact_execution_version_required": {
          "type": "boolean",
          "const": true
        },
        "execution_hash_binding_required": {
          "type": "boolean",
          "const": true
        },
        "observed_outcome_requires_direct_result": {
          "type": "boolean",
          "const": true
        },
        "observed_outcome_requires_evidence": {
          "type": "boolean",
          "const": true
        },
        "not_available_not_observed": {
          "type": "boolean",
          "const": true
        },
        "unknown_not_observed": {
          "type": "boolean",
          "const": true
        },
        "observation_not_inference": {
          "type": "boolean",
          "const": true
        },
        "direct_result_digest_required": {
          "type": "boolean",
          "const": true
        },
        "cross_object_binding_runtime_validation_required": {
          "type": "boolean",
          "const": true
        },
        "temporal_order_runtime_validation_required": {
          "type": "boolean",
          "const": true
        },
        "append_only_genealogy": {
          "type": "boolean",
          "const": true
        },
        "no_automatic_success_claim": {
          "type": "boolean",
          "const": true
        },
        "no_automatic_consequence_claim": {
          "type": "boolean",
          "const": true
        },
        "no_regulated_certification_claim": {
          "type": "boolean",
          "const": true
        },
        "no_public_authority_claim": {
          "type": "boolean",
          "const": true
        },
        "fail_closed": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 600
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "OBSERVED",
              "CONTESTED"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "observation_source": {
            "type": "object"
          },
          "direct_result": {
            "type": "object"
          },
          "evidence_state": {
            "const": "PRESENT"
          },
          "evidence_reference": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "NOT_AVAILABLE"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "observed_at": {
            "type": "null"
          },
          "observation_source": {
            "type": "null"
          },
          "direct_result": {
            "type": "null"
          },
          "evidence_state": {
            "const": "PRESENT"
          },
          "evidence_reference": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "PENDING",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "observed_at": {
            "type": "null"
          },
          "observation_source": {
            "type": "null"
          },
          "direct_result": {
            "type": "null"
          }
        }
      }
    }
  ]
}
