{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuelcoletta1-source.github.io/hermeticum-bce-platform/schemas/hbce-authorization.schema.json",
  "title": "HBCE Platform Core Authorization Schema v1",
  "description": "Canonical HBCE Platform Core schema representing a bounded decision about a specific action request. Authorization binds a principal and actor to an exact authority version, mandate version, capability version, operational space, enforcement point, action digest, request digest, temporal window and replay-control policy. Authorization does not constitute execution, execution success, legal certification or public authority status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proto",
    "kind",
    "version",
    "authorization_id",
    "authorization_version",
    "principal_ref",
    "actor_ref",
    "authority_ref",
    "authority_version",
    "mandate_ref",
    "mandate_version",
    "capability_ref",
    "capability_version",
    "dependency_commitments",
    "iospace_ref",
    "enforcement_point_ref",
    "action_binding",
    "decision_source",
    "decision_basis",
    "state",
    "decided_at",
    "valid_from",
    "valid_until",
    "created_at",
    "updated_at",
    "evidence_state",
    "evidence_reference",
    "replay_guard",
    "payload_sha256",
    "append_only",
    "genealogy",
    "boundary"
  ],
  "properties": {
    "proto": {
      "type": "string",
      "const": "HBCE-AUTHORIZATION-v1"
    },
    "kind": {
      "type": "string",
      "enum": [
        "HBCE_CORE_AUTHORIZATION"
      ]
    },
    "version": {
      "type": "string",
      "const": "v1"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^AZN-[0-9A-Z:\\-_.]+$",
      "minLength": 5,
      "maxLength": 128,
      "description": "Canonical authorization identifier."
    },
    "authorization_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Version of this authorization object, distinct from the schema version."
    },
    "principal_ref": {
      "type": "string",
      "pattern": "^[A-Z0-9_\\-:.]+$",
      "minLength": 3,
      "maxLength": 160,
      "description": "Reference to the principal on whose behalf the specific action is evaluated."
    },
    "actor_ref": {
      "type": "string",
      "pattern": "^[A-Z0-9_\\-:.]+$",
      "minLength": 3,
      "maxLength": 160,
      "description": "Reference to the actor permitted or denied use of this authorization."
    },
    "authority_ref": {
      "type": "string",
      "pattern": "^AUT-[0-9A-Z:\\-_.]+$",
      "minLength": 5,
      "maxLength": 128,
      "description": "Exact authority identifier evaluated for this authorization."
    },
    "authority_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Exact authority version evaluated for this authorization."
    },
    "mandate_ref": {
      "type": "string",
      "pattern": "^MND-[0-9A-Z:\\-_.]+$",
      "minLength": 5,
      "maxLength": 128
    },
    "mandate_version": {
      "type": "integer",
      "minimum": 1
    },
    "capability_ref": {
      "type": "string",
      "pattern": "^CAP-[0-9A-Z:\\-_.]+$",
      "minLength": 5,
      "maxLength": 128
    },
    "capability_version": {
      "type": "integer",
      "minimum": 1
    },
    "dependency_commitments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_sha256",
        "mandate_sha256",
        "capability_sha256"
      ],
      "properties": {
        "authority_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash commitment to the exact authority payload evaluated."
        },
        "mandate_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash commitment to the exact mandate payload evaluated."
        },
        "capability_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash commitment to the exact capability payload evaluated."
        }
      }
    },
    "iospace_ref": {
      "type": "string",
      "pattern": "^[A-Z0-9_\\-:.]+$",
      "minLength": 3,
      "maxLength": 160,
      "description": "Exact operational-space reference in which the action is evaluated."
    },
    "enforcement_point_ref": {
      "type": "string",
      "pattern": "^[A-Z0-9_\\-:.]+$",
      "minLength": 3,
      "maxLength": 160,
      "description": "Controlled reference to the enforcement point expected to consume and verify this authorization."
    },
    "action_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_class",
        "target_ref",
        "action_sha256",
        "request_sha256"
      ],
      "properties": {
        "action_class": {
          "type": "string",
          "pattern": "^[A-Z0-9_\\-:.]+$",
          "minLength": 3,
          "maxLength": 128,
          "description": "Controlled class of the exact requested action."
        },
        "target_ref": {
          "type": "string",
          "pattern": "^[A-Z0-9_\\-:.]+$",
          "minLength": 3,
          "maxLength": 160,
          "description": "Controlled reference to the exact target of the requested action."
        },
        "action_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash commitment to the canonical action payload."
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash commitment to the canonical request envelope evaluated for this authorization."
        }
      }
    },
    "decision_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "authorizer_refs"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "HUMAN",
            "POLICY_ENGINE",
            "HUMAN_AND_POLICY",
            "EMERGENCY_CONTROLLED"
          ],
          "description": "Controlled class of the decision source. The value does not create legal or public authority."
        },
        "authorizer_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_\\-:.]+$",
            "minLength": 3,
            "maxLength": 160
          },
          "description": "Controlled references to the human, engine or controlled decision entities participating in the authorization decision."
        }
      }
    },
    "decision_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_refs",
        "condition_refs"
      ],
      "properties": {
        "policy_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_\\-:.]+$",
            "minLength": 3,
            "maxLength": 160
          }
        },
        "condition_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_\\-:.]+$",
            "minLength": 3,
            "maxLength": 160
          }
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "PENDING",
        "AUTHORIZED",
        "DENIED",
        "REVIEW_REQUIRED",
        "EXPIRED",
        "REVOKED",
        "SUPERSEDED",
        "UNKNOWN"
      ],
      "description": "Authorization decision/lifecycle state. Only AUTHORIZED represents a positive authorization decision. PENDING, REVIEW_REQUIRED and UNKNOWN must fail closed for execution."
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Timestamp of the authorization decision when established. PENDING requires null. UNKNOWN may remain null when the decision instant cannot be established. Decision-bearing and post-decision lifecycle states require a date-time."
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "description": "Authorization validity must be explicitly time bounded. Indefinite authorization is intentionally not represented."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_state": {
      "type": "string",
      "enum": [
        "PRESENT",
        "MISSING",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ],
      "description": "State of evidence supporting the authorization decision. An AUTHORIZED state requires PRESENT evidence in this schema."
    },
    "evidence_reference": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9_:\\-.]+$",
      "minLength": 3,
      "maxLength": 160,
      "description": "Controlled minimized reference to authorization evidence. Raw evidence remains outside this object."
    },
    "replay_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "replay_key_sha256",
        "max_uses",
        "usage_counter_ref",
        "requires_atomic_consumption"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "SINGLE_USE",
            "BOUNDED_USE"
          ],
          "description": "Authorization replay policy. Unlimited reuse is intentionally not represented."
        },
        "replay_key_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash commitment used to bind replay-control state to this authorization."
        },
        "max_uses": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum permitted consumptions of this authorization under the applicable runtime enforcement policy."
        },
        "usage_counter_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9_:\\-.]+$",
          "minLength": 3,
          "maxLength": 160,
          "description": "Reference to append-only or otherwise controlled consumption state. Runtime enforcement is outside this schema."
        },
        "requires_atomic_consumption": {
          "type": "boolean",
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "SINGLE_USE"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "max_uses": {
                "const": 1
              }
            }
          }
        }
      ]
    },
    "revocation_reference": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9_:\\-.]+$",
      "minLength": 3,
      "maxLength": 160
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^AZN-[0-9A-Z:\\-_.]+$",
      "minLength": 5,
      "maxLength": 128
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 commitment for the controlled canonical authorization payload according to the applicable hashing profile."
    },
    "append_only": {
      "type": "boolean",
      "const": true
    },
    "genealogy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_from",
        "previous_state",
        "new_state",
        "cause",
        "evidence_reference",
        "timestamp",
        "hash"
      ],
      "properties": {
        "derived_from": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^AZN-[0-9A-Z:\\-_.]+$",
          "minLength": 5,
          "maxLength": 128
        },
        "previous_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "PENDING",
            "AUTHORIZED",
            "DENIED",
            "REVIEW_REQUIRED",
            "EXPIRED",
            "REVOKED",
            "SUPERSEDED",
            "UNKNOWN"
          ]
        },
        "new_state": {
          "type": "string",
          "enum": [
            "PENDING",
            "AUTHORIZED",
            "DENIED",
            "REVIEW_REQUIRED",
            "EXPIRED",
            "REVOKED",
            "SUPERSEDED",
            "UNKNOWN"
          ]
        },
        "cause": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240,
          "description": "Controlled safe cause text or reference. Must not contain raw sensitive evidence."
        },
        "evidence_reference": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9_:\\-.]+$",
          "minLength": 3,
          "maxLength": 160
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_minimization",
        "reference_over_raw_evidence",
        "authorization_not_authority",
        "authorization_not_execution",
        "authorized_not_executed",
        "request_digest_binding_required",
        "action_digest_binding_required",
        "dependency_versions_explicit",
        "dependency_hashes_explicit",
        "authority_must_be_usable_at_decision",
        "stale_or_revoked_authority_invalidates_use",
        "time_window_required",
        "replay_protection_required",
        "atomic_consumption_required",
        "unknown_not_authorized",
        "review_required_not_authorized",
        "append_only_genealogy",
        "no_automatic_success_claim",
        "no_regulated_certification_claim",
        "no_public_authority_claim",
        "fail_closed"
      ],
      "properties": {
        "data_minimization": {
          "type": "boolean",
          "const": true
        },
        "reference_over_raw_evidence": {
          "type": "boolean",
          "const": true
        },
        "authorization_not_authority": {
          "type": "boolean",
          "const": true
        },
        "authorization_not_execution": {
          "type": "boolean",
          "const": true
        },
        "authorized_not_executed": {
          "type": "boolean",
          "const": true
        },
        "request_digest_binding_required": {
          "type": "boolean",
          "const": true
        },
        "action_digest_binding_required": {
          "type": "boolean",
          "const": true
        },
        "dependency_versions_explicit": {
          "type": "boolean",
          "const": true
        },
        "dependency_hashes_explicit": {
          "type": "boolean",
          "const": true
        },
        "authority_must_be_usable_at_decision": {
          "type": "boolean",
          "const": true
        },
        "stale_or_revoked_authority_invalidates_use": {
          "type": "boolean",
          "const": true
        },
        "time_window_required": {
          "type": "boolean",
          "const": true
        },
        "replay_protection_required": {
          "type": "boolean",
          "const": true
        },
        "atomic_consumption_required": {
          "type": "boolean",
          "const": true
        },
        "unknown_not_authorized": {
          "type": "boolean",
          "const": true
        },
        "review_required_not_authorized": {
          "type": "boolean",
          "const": true
        },
        "append_only_genealogy": {
          "type": "boolean",
          "const": true
        },
        "no_automatic_success_claim": {
          "type": "boolean",
          "const": true
        },
        "no_regulated_certification_claim": {
          "type": "boolean",
          "const": true
        },
        "no_public_authority_claim": {
          "type": "boolean",
          "const": true
        },
        "fail_closed": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 600,
      "description": "Controlled safe note only. Must not contain raw sensitive evidence, secrets, credentials, identity documents, raw prompts, raw outputs or client files."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "PENDING"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "decided_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "AUTHORIZED",
              "DENIED",
              "REVIEW_REQUIRED",
              "EXPIRED",
              "REVOKED",
              "SUPERSEDED"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "decided_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "AUTHORIZED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "evidence_state": {
            "const": "PRESENT"
          },
          "evidence_reference": {
            "type": "string"
          },
          "replay_guard": {
            "properties": {
              "usage_counter_ref": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
