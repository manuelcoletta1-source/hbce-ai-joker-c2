# HBCE / AI JOKER-C2 — Environment Example
# ------------------------------------------------------------
# Copy these variables into your local environment or Vercel
# Environment Variables panel.
#
# Never commit real API keys, production secrets, private tokens,
# credentials, identity documents, personal data or operational secrets.
#
# OpenAI provides the cognitive engine.
# HBCE / JOKER-C2 provides identity, governance, event continuity,
# proof generation and audit-ready traceability.

# ------------------------------------------------------------
# OpenAI Cognitive Engine
# ------------------------------------------------------------

OPENAI_API_KEY=

# Standard model used by the JOKER-C2 runtime.
JOKER_MODEL=gpt-5.5

# Deep model used for reasoning-heavy, audit, code, governance,
# document and diagnostic operations.
JOKER_DEEP_MODEL=gpt-5.5

# ------------------------------------------------------------
# HBCE Runtime Mode
# ------------------------------------------------------------

HBCE_DEMO_MODE=true
HBCE_RUNTIME_MODE=pilot

# ------------------------------------------------------------
# HBCE / JOKER-C2 Canonical Runtime Metadata
# ------------------------------------------------------------

HBCE_RUNTIME_NAME=AI_JOKER_C2
HBCE_RUNTIME_ROLE=HBCE_governed_runtime
HBCE_ENGINE_PROVIDER=OpenAI
HBCE_ENGINE_ROLE=cognitive_engine
HBCE_ENGINE_API_MODE=chat.completions

# Canonical project birth date for HBCE R&D / AI JOKER-C2.
HBCE_PROJECT_BIRTH_DATE=2026-01-19

# Canonical runtime checkpoint currently used by the demo.
HBCE_RUNTIME_CHECKPOINT=EVT-0015-AI
HBCE_RUNTIME_CYCLE=UP-MESE-4
HBCE_CORE=HBCE-CORE-v3

# ------------------------------------------------------------
# Public Demo Boundaries
# ------------------------------------------------------------

HBCE_SYNTHETIC_DATA_ONLY=true
HBCE_HASH_ONLY=true
HBCE_FAIL_CLOSED=true
HBCE_AUDIT_FIRST=true
HBCE_GDPR_MIN=true

# ------------------------------------------------------------
# Operational Boundary Notice
# ------------------------------------------------------------
# The demo uses synthetic or authorized data only.
# HBCE-IPR does not replace CIE, SPID, passport, eIDAS
# or official identity documents.
# IPR is an internal operational identity record for governed AI workflows.
